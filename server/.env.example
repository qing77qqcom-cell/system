# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交到 Git
#
# ---------- 两套数据库模式，按需切换 ----------
# 1. 本地 Docker（开发阶段，不受免费实例冷冻限制）：
#    DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oa_ticket
#    DB_SSL=off
#
# 2. 托管数据库（部署用，从控制台复制）：
#    DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#    DB_SSL=on  (或省略，URL 含 sslmode=require 时自动推断)
#
# DB_SSL 规则：
#   'on'  → 强制启用 ssl: { rejectUnauthorized: false }（Neon/Supabase/DigitalOcean）
#   'off' → 完全关闭 SSL（本地 Docker / 自托管）
#   缺省  → 自动：URL 含 sslmode=require 则 on，否则 off

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oa_ticket
DB_SSL=off

# JWT 签名密钥：至少 32 字节随机值
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-your-random-64-hex-chars

# 服务端口
PORT=3000

# 运行环境：development / production
NODE_ENV=development

# 允许跨域的前端来源，多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5173

# JWT 有效期（remember=false / true）
JWT_EXPIRES=1d
JWT_EXPIRES_REMEMBER=7d

# 附件上传目录（相对 server 目录）
UPLOAD_DIR=uploads
